{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "cpl",
  "version": "0.1.0",
  "identifier": "com.ars.cpl",
  "build": {
    "beforeDevCommand": "bun run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "bun run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "cpl",
        "width": 800,
        "height": 600,
        "visible": false,
        "maximized": true,
        "url": "/home"
      },
      {
        "label": "splash",
        "title": "CPL - Controle de Produção de Leite",
        "width": 300,
        "height": 400,
        "resizable": false,
        "center": true,
        "visible": false,
        "url": "/splashscreen"
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "msi",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "allowDowngrades": true,
      "certificateThumbprint": null,
      "digestAlgorithm": null,
      "nsis": {
        "installMode": "perMachine",
        "minimumWebview2Version": "110.0.1531.0"
      },
      "signCommand": null,
      "timestampUrl": null,
      "tsp": false,
      "webviewInstallMode": {
        "silent": true,
        "type": "embedBootstrapper"
      },
      "wix": null
    }
  }
}
